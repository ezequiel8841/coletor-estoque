    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.invstock.coletorestoque"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.invstock.coletorestoque",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Coletor Estoque use a câmera para ler códigos de barras."
        }
      ]
    ]
  }
}
